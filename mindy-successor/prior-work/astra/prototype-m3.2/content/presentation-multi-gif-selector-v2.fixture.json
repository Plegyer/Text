{
  "formatVersion": 2,
  "kind": "presentation-multi-gif-selector-reference",
  "status": "AUTHORING_REFERENCE_NOT_RUNTIME_WIRED",
  "algorithm": {
    "hash": "FNV-1a 32-bit over ASCII/UTF-8-compatible seed bytes",
    "seed": "presentationId|occurrenceKey|poolVersion",
    "unweighted": "selectedIndex = hash % candidateCount",
    "weighted": "point = (hash / 2^32) * totalPositiveWeight; choose first cumulative weight greater than point",
    "candidateKeyRole": "presentation-only stable member identity",
    "gameplayRngRequired": false,
    "saveMutationRequired": false
  },
  "constraints": {
    "candidatesMin": 3,
    "candidatesMax": 5,
    "weightsOptional": true,
    "weightMustBePositiveFinite": true,
    "candidateKeysUniqueWithinPool": true,
    "frameTimePersistence": false
  },
  "scenarios": [
    {
      "id": "same-occurrence-initial",
      "presentationId": "job/lumber/shift/spring/default",
      "occurrenceKey": "life-7|lumber.shift|12|job/lumber/shift/spring/default",
      "poolVersion": "starter-lumber-spring-v1",
      "selectionPolicy": "unweighted-fnv1a32-modulo",
      "candidates": [
        {
          "key": "lumber-spring-a",
          "weight": 1
        },
        {
          "key": "lumber-spring-b",
          "weight": 1
        },
        {
          "key": "lumber-spring-c",
          "weight": 1
        },
        {
          "key": "lumber-spring-d",
          "weight": 1
        }
      ],
      "expected": {
        "seed": "job/lumber/shift/spring/default|life-7|lumber.shift|12|job/lumber/shift/spring/default|starter-lumber-spring-v1",
        "hash": 2642129024,
        "index": 0,
        "key": "lumber-spring-a"
      }
    },
    {
      "id": "same-occurrence-reload",
      "presentationId": "job/lumber/shift/spring/default",
      "occurrenceKey": "life-7|lumber.shift|12|job/lumber/shift/spring/default",
      "poolVersion": "starter-lumber-spring-v1",
      "selectionPolicy": "unweighted-fnv1a32-modulo",
      "candidates": [
        {
          "key": "lumber-spring-a",
          "weight": 1
        },
        {
          "key": "lumber-spring-b",
          "weight": 1
        },
        {
          "key": "lumber-spring-c",
          "weight": 1
