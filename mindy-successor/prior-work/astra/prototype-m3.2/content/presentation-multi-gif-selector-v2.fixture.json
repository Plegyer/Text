      "expected": {
        "seed": "job/lumber/shift/spring/default|life-7|lumber.shift|12|job/lumber/shift/spring/default|starter-lumber-spring-v1",
        "hash": 2642129024,
        "index": 0,
        "key": "lumber-spring-a"
      }
    },
    {
      "id": "next-occurrence",
      "presentationId": "job/lumber/shift/spring/default",
