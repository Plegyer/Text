    "expectedSameCandidate": true,
    "expectedSameHash": true,
    "gameplayRngRead": false,
    "gameplayRngWrite": false,
    "saveWrite": false
  },
  "variationProof": {
    "note": "Different occurrence keys are allowed to select a different candidate; equality is not required.",
    "occurrenceA": "lumber-spring-a",
    "occurrenceB": "lumber-spring-b",
    "hashesDiffer": true
  }
}
