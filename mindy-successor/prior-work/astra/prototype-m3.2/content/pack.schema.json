{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,79}$"
    },
    "reads": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{1,79}$"
      }
    },
    "writes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{1,79}$"
      }
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{1,79}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "image",
              "gif",
              "video"
            ]
          },
          "src": {
            "type": "string",
            "pattern": "^assets\\/[a-zA-Z0-9/_-]+\\.(svg|png|webp|gif|mp4|webm)$"
          },
          "alt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": [
          "id",
          "kind",
          "src",
          "alt"
        ],
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{1,79}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "trigger": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{1,79}$"
            }
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "chance": {
            "type": "object",
            "properties": {
              "base": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "stat": {
                "type": "string",
                "enum": [
                  "strength",
                  "endurance",
                  "dexterity",
                  "perception",
                  "intelligence",
                  "magic",
                  "empathy",
                  "persuasion",
                  "composure",
                  "organization",
                  "lust"
                ]
              },
              "perPoint": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "max": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "base",
              "stat",
              "perPoint",
              "max"
            ],
            "additionalProperties": false
          },
          "cooldownDays": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "variantCooldownDays": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "maxShows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "conditions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "variants": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{1,79}$"
                },
                "text": {
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 5000
                },
                "conditions": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema0"
                  }
                },
                "media": {
                  "maxItems": 6,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.-]{1,79}$"
                  }
                }
              },
              "required": [
                "id",
                "text",
                "conditions",
                "media"
              ],
              "additionalProperties": false
            }
          },
          "choices": {
            "minItems": 1,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{1,79}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "text": {
                  "type": "string",
                  "maxLength": 3000
                },
                "media": {
                  "maxItems": 6,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.-]{1,79}$"
                  }
                },
                "conditions": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema0"
                  }
                },
                "effects": {
                  "maxItems": 12,
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "metric"
                          },
                          "key": {
                            "type": "string",
                            "enum": [
                              "strength",
                              "endurance",
                              "dexterity",
                              "perception",
                              "intelligence",
                              "magic",
                              "empathy",
                              "persuasion",
                              "composure",
                              "organization",
                              "lust",
                              "money",
                              "energy",
                              "health",
                              "stress",
                              "debt",
                              "work",
                              "lessons",
                              "alchemy",
                              "trust"
                            ]
                          },
                          "delta": {
                            "type": "integer",
                            "minimum": -1000,
                            "maximum": 1000
                          }
                        },
                        "required": [
                          "kind",
                          "key",
                          "delta"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "flag"
                          },
                          "key": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_.-]{1,79}$"
                          },
                          "value": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "kind",
                          "key",
                          "value"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "item"
                          },
                          "id": {
                            "type": "string",
                            "enum": [
                              "herb",
                              "tonic",
                              "scales"
                            ]
                          },
                          "delta": {
                            "type": "integer",
                            "minimum": -10,
                            "maximum": 10
                          }
                        },
                        "required": [
                          "kind",
                          "id",
                          "delta"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "housing"
                          },
                          "value": {
                            "type": "string",
                            "enum": [
                              "room",
                              "hostel",
                              "shelter"
                            ]
                          }
                        },
                        "required": [
                          "kind",
                          "value"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              },
              "required": [
                "id",
                "label",
                "text",
                "conditions",
                "effects"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "trigger",
          "priority",
          "cooldownDays",
          "variantCooldownDays",
          "maxShows",
          "conditions",
          "variants",
          "choices"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "reads",
    "writes",
    "media",
    "events"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "metric"
            },
            "key": {
              "type": "string",
              "enum": [
                "strength",
                "endurance",
                "dexterity",
                "perception",
                "intelligence",
                "magic",
                "empathy",
                "persuasion",
                "composure",
                "organization",
                "lust",
                "money",
                "energy",
                "health",
                "stress",
                "debt",
                "work",
                "lessons",
                "alchemy",
                "trust"
              ]
            },
            "op": {
              "type": "string",
              "enum": [
                "gte",
                "lte",
                "eq"
              ]
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            }
          },
          "required": [
            "kind",
            "key",
            "op",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "visits"
            },
            "action": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{1,79}$"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            }
          },
          "required": [
            "kind",
            "action",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "flag"
            },
            "key": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{1,79}$"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "key",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "season"
            },
            "value": {
              "type": "string",
              "enum": [
                "spring",
                "summer",
                "autumn",
                "winter"
              ]
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "housing"
            },
            "value": {
              "type": "string",
              "enum": [
                "room",
                "hostel",
                "shelter"
              ]
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "unlock"
            },
            "value": {
              "type": "string",
              "enum": [
                "guild",
                "scholar",
                "calendar",
                "host",
                "mediator",
                "court",
                "vitality"
              ]
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "item"
            },
            "id": {
              "type": "string",
              "enum": [
                "herb",
                "tonic",
                "scales"
              ]
            },
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            }
          },
          "required": [
            "kind",
            "id",
            "count"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "all",
                "any"
              ]
            },
            "conditions": {
              "minItems": 1,
              "maxItems": 16,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "kind",
            "conditions"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "not"
            },
            "condition": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "kind",
            "condition"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
