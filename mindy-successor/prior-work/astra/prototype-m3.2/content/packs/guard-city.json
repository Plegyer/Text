      ],
      "variants": [
        {
          "id": "street-survival",
          "text": "Personal experience of sleeping rough changes which details the Guard notices: where a blocked passage is dangerous and where someone is simply looking for a dry place. That perspective changes the wording of a decision, not lodging rules, wages, or existing debt. Neither assistance nor an order to clear a passage creates or clears a separate Guard debt. Existing obligations belong to their own systems; Guard content records only the concrete city-duty decision.",
          "conditions": [
            {
              "kind": "housingTier",
              "value": "street"
            }
          ],
          "media": []
        },
        {
          "id": "cheap-room",
          "text": "Experience with cheap shared lodging makes it easier to understand why people protect a queue place, late entry, or somewhere to keep belongings. The Guard response can become more precise without turning into free housing or a new financial system. Neither assistance nor an order to clear a passage creates or clears a separate Guard debt. Existing obligations belong to their own systems; Guard content records only the concrete city-duty decision.",
          "conditions": [
            {
              "kind": "housingTier",
              "value": "cheap"
            }
          ],
          "media": []
        },
        {
          "id": "default",
          "text": "Neither assistance nor an order to clear a passage creates or clears a separate Guard debt. Existing obligations belong to their own systems; Guard content records only the concrete city-duty decision.",
          "conditions": [],
          "media": []
        }
      ],
      "choices": [
        {
          "id": "route-to-shelter",
          "label": "Route people toward existing shelter contacts",
          "text": "A person on the street or in cheap lodging does not become a suspect because of housing status alone. The shift can route them toward available shelter or assistance while preserving ordinary passage rules and creating no new debt.",
          "conditions": [],
          "effects": [
            {
              "kind": "addCareerFact",
              "career": "guard",
              "fact": "poverty-response-recorded"
            },
            {
              "kind": "addCareerFact",
              "career": "guard",
              "fact": "poverty-relief-choice"
            },
            {
              "kind": "incrementCareerCounter",
