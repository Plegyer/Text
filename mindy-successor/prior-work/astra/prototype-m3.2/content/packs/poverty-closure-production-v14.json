            }
          ]
        }
      ],
      "variants": [
        {
          "id": "spring-noise",
          "text": "Spring rain keeps more people indoors, so every late conversation carries through the thin partitions. The room is cheaper because privacy is limited, not because the night secretly changes your stats.",
          "conditions": [
            {
              "kind": "calendarSeason",
              "value": "spring"
            }
          ],
          "media": [
            "stage.room"
          ]
        },
        {
          "id": "summer-privacy",
          "text": "In summer the shared room stays warm and busy. You can sleep under a roof, but changing clothes, sorting belongings, and finding a quiet corner all require more attention to other people's space.",
          "conditions": [
            {
              "kind": "calendarSeason",
              "value": "summer"
            }
          ],
          "media": [
            "stage.room"
          ]
        },
        {
          "id": "autumn-shared-space",
          "text": "Autumn damp brings wet coats and bags into the same narrow room. Everyone has a place, but the passage and drying space have to be negotiated rather than assumed.",
          "conditions": [
            {
              "kind": "calendarSeason",
              "value": "autumn"
            }
          ],
          "media": [
            "stage.room"
          ]
        },
        {
          "id": "winter-quiet-hours",
          "text": "Winter makes the shared room valuable and crowded at the same time. Quiet hours matter more because one restless person can wake almost everyone near the stove.",
          "conditions": [
            {
              "kind": "calendarSeason",
              "value": "winter"
            }
          ],
          "media": [
            "stage.room"
          ]
        },
        {
          "id": "shared-room",
          "text": "The cheap room buys a roof and a predictable bed, but not much privacy. Noise, shared space, and other people's schedules are part of the bargain.",
          "conditions": [],
          "media": [
            "stage.room"
          ]
        }
      ],
      "choices": [
        {
          "id": "ask-for-quiet",
          "label": "Ask for a little quiet",
          "text": "You ask plainly and keep the request small. The room remains shared; no extra cost or hidden penalty is created.",
          "conditions": [],
          "effects": []
        },
        {
          "id": "keep-small-space",
          "label": "Keep to your space",
          "text": "You keep your belongings close and work within the room's shared rules without turning the inconvenience into a new mechanic.",
          "conditions": [],
          "effects": []
        }
      ]
    },
