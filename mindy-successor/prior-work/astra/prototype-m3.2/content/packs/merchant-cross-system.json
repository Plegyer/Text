          "kind": "careerStage",
          "career": "merchant",
          "stage": "networked-merchant"
        },
        {
          "kind": "worldFact",
          "fact": "lumber.forest.truth-known",
          "present": true
        },
        {
          "kind": "careerFact",
          "career": "merchant",
          "fact": "lumber-input-known",
          "present": false
        }
      ],
      "variants": [
        {
          "id": "default",
          "text": "Lumber knowledge about a confirmed forest boundary becomes only a route and source fact for Merchant. You record the supply constraint without changing Forest, Lumber, or access rights within them.\n\nA Lumber connection gives the network knowledge of one dependable source and its route constraints. Patron of Routes values the verified link without taking ownership of lumber production or Forest.",
          "conditions": [],
          "media": []
        }
      ],
      "choices": [
        {
          "id": "record",
          "label": "Record the Lumber route input",
          "text": "Carry the shipped Lumber result into Merchant route preparation only.",
          "conditions": [],
          "effects": [
            {
              "kind": "incrementCareerCounter",
              "career": "merchant",
              "counter": "route_inputs",
              "amount": 1
            },
            {
              "kind": "addCareerFact",
              "career": "merchant",
              "fact": "lumber-input-known"
            }
          ]
        }
      ]
    },
