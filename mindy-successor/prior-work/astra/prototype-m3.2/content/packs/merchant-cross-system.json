      "id": "merchant.cross.lumber-route",
      "title": "A Lumber route observation becomes a trade input",
      "sourceDomain": "merchant",
      "trigger": [],
      "reactionTriggers": [
        {
          "kind": "worldFactAdded",
          "fact": "lumber.forest.truth-known"
