  "events": [
    {
      "id": "stage.goblin",
      "title": "Незваный помощник",
      "trigger": [
        "lumber"
      ],
      "priority": 35,
      "cooldownDays": 2,
      "variantCooldownDays": 2,
      "maxShows": 100,
      "chance": {
        "base": 0.08,
        "stat": "lust",
        "perPoint": 0.012,
        "max": 0.85
      },
      "conditions": [
        {
          "kind": "flag",
          "key": "woods.met",
          "value": true
        },
        {
          "kind": "visits",
          "action": "lumber",
          "value": 2
        }
      ],
      "variants": [
        {
          "id": "curious",
          "text": "Гоблин-плотник по имени Тик появляется у верстака. Вместо помощи он с неожиданным старанием приглашает вас прогуляться после смены. Вы сами решаете, как ответить.",
          "media": [
            "stage.goblin"
          ],
          "conditions": [
            {
              "kind": "metric",
              "key": "lust",
              "op": "gte",
              "value": 6
            }
          ]
        },
        {
          "id": "default",
          "text": "Взрослый гоблин-плотник Тик спорит о том, кто лучше управляется с инструментом. Можно принять безопасный тренировочный поединок или просто вернуть его к работе.",
          "media": [
            "stage.goblin"
          ],
          "conditions": []
        }
      ],
      "choices": [
        {
          "id": "spar",
          "label": "Потренироваться с Тиком",
          "text": "Вы проводите дружеский поединок деревянными палками. Тик признаёт вашу победу над его самоуверенностью.",
          "conditions": [],
          "effects": [
            {
              "kind": "metric",
              "key": "dexterity",
              "delta": 1
            }
          ],
          "media": [
            "stage.sparring"
          ]
        },
        {
          "id": "flirt",
          "label": "Ответить на флирт",
          "text": "Вы соглашаетесь на прогулку после работы. Тик мгновенно вспоминает, что обещал закончить доски. Вечером вы вместе идёте к ручью; разговор получается гораздо приятнее спора об инструментах.",
          "conditions": [
            {
              "kind": "metric",
              "key": "lust",
              "op": "gte",
              "value": 6
            }
          ],
          "effects": [
            {
              "kind": "metric",
              "key": "persuasion",
              "delta": 1
            }
          ],
          "media": [
            "stage.flirt"
          ]
        },
        {
          "id": "work",
          "label": "Остаться за работой",
          "text": "Вы возвращаетесь к верстаку. Тик решает доказать свою полезность делом.",
          "conditions": [],
          "effects": [],
          "media": [
            "stage.lumber"
          ]
        }
      ]
