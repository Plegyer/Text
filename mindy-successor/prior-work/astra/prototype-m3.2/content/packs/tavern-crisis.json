              "fact": "crisis-resolved"
            },
            {
              "kind": "addCareerFact",
              "career": "tavern",
              "fact": "crisis-innkeeper"
            }
          ]
        },
        {
          "id": "manage-information",
          "label": "Resolve the conflict through verified information",
          "text": "You start with information: separate confirmed details, rumors, and private facts, then pass on only what is needed to solve the problem. The value is not the number of secrets you possess, but that people can act on accurate information.",
          "conditions": [
            {
              "kind": "careerFact",
