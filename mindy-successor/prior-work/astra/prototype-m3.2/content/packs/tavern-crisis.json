      "variants": [
        {
          "id": "default",
          "text": "The house faces crowded rooms, a disrupted supply, and a request to keep one guest's route private at the same time. There is no single clever sentence that solves all three; you have to choose which responsibility you take on and which risk remains for the rest of the house.",
          "conditions": [],
          "media": []
        }
      ],
      "choices": [
        {
          "id": "stabilize-house",
          "label": "Stabilize rooms and supplies through records",
          "text": "You start with the stability of the house: check available rooms, working records, and what actually remains in storage. It is not the most dramatic solution, but the next shift knows what was promised, what is missing, and who owns the follow-up.",
          "conditions": [
            {
              "kind": "careerFact",
              "career": "tavern",
              "fact": "school-records-ready",
              "present": true
            },
            {
              "kind": "careerFact",
              "career": "tavern",
              "fact": "guest-ledger-evidence-ready",
              "present": true
            },
            {
              "kind": "careerCounter",
              "career": "tavern",
              "counter": "supply_pressure",
              "op": "gte",
              "value": 2
            }
          ],
          "effects": [
