        {
          "kind": "not",
          "condition": {
            "kind": "careerStage",
            "career": "merchant",
            "stage": "stall-hand"
          }
        }
      ],
      "variants": [
        {
          "id": "default",
          "text": "Simple appraisal scales help compare weight and condition consistently. They improve one Merchant appraisal option; they do not calculate a universal market price.",
          "conditions": [],
          "media": []
        }
      ],
      "choices": [
        {
          "id": "take",
          "label": "Take the appraisal scales",
          "text": "Keep the tool for future appraisal checks.",
          "conditions": [],
          "effects": [
            {
              "kind": "addItem",
              "id": "merchant_appraisal_scales",
              "count": 1
            },
            {
              "kind": "addCareerFact",
              "career": "merchant",
              "fact": "appraisal-scales-issued"
            }
          ]
        },
        {
          "id": "defer",
          "label": "Keep working without them",
          "text": "Ordinary Merchant work remains available.",
          "conditions": [],
          "effects": []
        }
      ]
    },
