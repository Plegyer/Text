{
  "schemaVersion": 1,
  "id": "merchant.items",
  "reads": [],
  "writes": [],
  "capabilities": {
    "reads": {
      "careers": [
        "merchant"
      ],
      "inventory": [
        "merchant_appraisal_scales",
        "merchant_manifest_case",
        "merchant_sample_kit"
      ],
      "itemCapabilities": [
        "merchant_appraise_goods",
        "merchant_verify_manifest",
        "merchant_handle_samples"
      ]
    },
    "writes": {
      "careers": [
        "merchant"
      ],
      "inventory": [
        "merchant_appraisal_scales",
        "merchant_manifest_case",
        "merchant_sample_kit"
      ]
    }
  },
  "media": [],
  "events": [
    {
      "id": "merchant.items.appraisal-scales",
      "title": "A narrow appraisal tool becomes available",
      "sourceDomain": "merchant",
      "trigger": [],
      "reactionTriggers": [
        {
          "kind": "careerCounterChanged",
          "career": "merchant",
          "counter": "appraisals"
        },
        {
          "kind": "careerTransition",
          "career": "merchant"
        },
        {
          "kind": "actionCompleted",
          "action": "merchant.shift"
        }
      ],
      "priorityClass": "normal_progression",
      "priority": 69,
      "blocking": true,
      "delivery": {
        "policy": "live"
      },
      "cooldownDays": 0,
      "variantCooldownDays": 0,
      "maxShows": 1,
      "conditions": [
        {
          "kind": "careerCounter",
          "career": "merchant",
          "counter": "appraisals",
          "op": "gte",
          "value": 1
        },
        {
          "kind": "itemCapability",
          "capability": "merchant_appraise_goods",
          "present": false
        },
        {
          "kind": "not",
          "condition": {
            "kind": "careerStage",
            "career": "merchant",
            "stage": "stall-hand"
          }
        }
      ],
      "variants": [
        {
          "id": "default",
          "text": "Appraisal scales help compare the weight and condition of two samples consistently. They improve the quality of one check but do not reveal a true market price or guarantee profit.\n\nIf the scale reading does not explain an unusual property of the goods, you preserve that uncertainty in the record. The tool helps expose a discrepancy rather than turning incomplete data into a confident answer.\n\nThe three tools change only the quality of specific Merchant checks and available options. They create no storage-capacity system, automatic valuation, or guaranteed trading bonus.",
          "conditions": [],
          "media": []
        }
      ],
      "choices": [
        {
          "id": "take",
          "label": "Take the appraisal scales",
          "text": "Keep the tool for future appraisal checks.",
          "conditions": [],
          "effects": [
            {
              "kind": "addItem",
              "id": "merchant_appraisal_scales",
              "count": 1
            },
            {
              "kind": "addCareerFact",
              "career": "merchant",
              "fact": "appraisal-scales-issued"
            }
          ]
        },
        {
          "id": "defer",
          "label": "Keep working without them",
          "text": "Ordinary Merchant work remains available.",
          "conditions": [],
          "effects": []
        }
      ]
    },
    {
      "id": "merchant.items.manifest-case",
      "title": "A manifest case supports repeatable records",
      "sourceDomain": "merchant",
      "trigger": [],
      "reactionTriggers": [
        {
          "kind": "careerFactAdded",
          "career": "merchant",
          "fact": "manifest-verified"
        },
        {
          "kind": "careerTransition",
          "career": "merchant"
        },
        {
          "kind": "actionCompleted",
          "action": "merchant.shift"
        }
      ],
      "priorityClass": "normal_progression",
      "priority": 68,
      "blocking": true,
      "delivery": {
        "policy": "live"
      },
      "cooldownDays": 0,
      "variantCooldownDays": 0,
      "maxShows": 1,
      "conditions": [
        {
          "kind": "careerStage",
          "career": "merchant",
          "stage": "networked-merchant"
        },
        {
          "kind": "careerFact",
          "career": "merchant",
          "fact": "manifest-verified",
          "present": true
        },
        {
          "kind": "itemCapability",
          "capability": "merchant_verify_manifest",
          "present": false
        }
      ],
      "variants": [
        {
          "id": "default",
          "text": "The manifest case keeps copies of terms, seals, and delivery notes together. Its value is that a dispute can be checked against a record, not that it grants special permission to bypass checks.\n\nIt helps to keep a short plain-language explanation beside a complicated manifest term. The case keeps both versions together so a formal document does not become a convenient place for ambiguity.\n\nThe three tools change only the quality of specific Merchant checks and available options. They create no storage-capacity system, automatic valuation, or guaranteed trading bonus.",
          "conditions": [],
          "media": []
        }
      ],
      "choices": [
        {
          "id": "take",
          "label": "Keep the manifest case",
          "text": "Use it for later delivery verification.",
          "conditions": [],
          "effects": [
            {
              "kind": "addItem",
              "id": "merchant_manifest_case",
              "count": 1
            },
            {
              "kind": "addCareerFact",
              "career": "merchant",
              "fact": "manifest-case-issued"
            }
          ]
        },
        {
          "id": "defer",
          "label": "Use ordinary records",
          "text": "Keep the career playable without the optional tool.",
          "conditions": [],
          "effects": []
        }
      ]
    },
    {
      "id": "merchant.items.sample-kit",
      "title": "A sample kit makes cross-system goods easier to document",
      "sourceDomain": "merchant",
      "trigger": [],
      "reactionTriggers": [
        {
          "kind": "careerFactAdded",
          "career": "merchant",
          "fact": "delivery-recorded"
        },
        {
          "kind": "careerTransition",
          "career": "merchant"
        },
        {
          "kind": "actionCompleted",
          "action": "merchant.shift"
        }
      ],
      "priorityClass": "normal_progression",
      "priority": 67,
      "blocking": true,
      "delivery": {
        "policy": "live"
      },
      "cooldownDays": 0,
      "variantCooldownDays": 0,
      "maxShows": 1,
      "conditions": [
        {
          "kind": "careerStage",
          "career": "merchant",
          "stage": "networked-merchant"
        },
        {
          "kind": "careerFact",
          "career": "merchant",
          "fact": "delivery-recorded",
          "present": true
        },
        {
          "kind": "itemCapability",
          "capability": "merchant_handle_samples",
          "present": false
        }
      ],
      "variants": [
        {
          "id": "default",
          "text": "The sample kit lets you separate a small labeled example from the main lot and compare it with the delivered result later. It does not expand general inventory or create new goods.\n\nThe three tools change only the quality of specific Merchant checks and available options. They create no storage-capacity system, automatic valuation, or guaranteed trading bonus.",
          "conditions": [],
          "media": []
        }
      ],
      "choices": [
        {
          "id": "take",
          "label": "Keep the sample kit",
          "text": "Use it when an existing Farm or Hunter result reaches Merchant.",
          "conditions": [],
          "effects": [
            {
              "kind": "addItem",
              "id": "merchant_sample_kit",
              "count": 1
            },
            {
              "kind": "addCareerFact",
              "career": "merchant",
              "fact": "sample-kit-issued"
            }
          ]
        },
        {
          "id": "defer",
          "label": "Do not take the kit",
          "text": "Continue ordinary trade without sample handling.",
          "conditions": [],
          "effects": []
        }
      ]
    }
  ]
}
