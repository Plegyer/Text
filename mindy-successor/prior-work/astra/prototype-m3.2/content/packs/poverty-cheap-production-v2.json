            {
              "kind": "calendarSeason",
              "value": "summer"
            }
          ],
          "media": [
            "stage.room"
          ]
        },
        {
          "id": "winter-stove",
          "text": "A small stove ticks in the corner while winter coats hang from every spare peg. The room is crowded, warm enough, and quieter than the street outside.",
