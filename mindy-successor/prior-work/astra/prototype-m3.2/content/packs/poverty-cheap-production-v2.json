      "variants": [
        {
          "id": "spring-window",
          "text": "In spring, the window is opened for a short while to let out the damp air after rain. The shared room is cramped, but at least belongings can dry before morning.",
          "conditions": [
            {
              "kind": "calendarSeason",
              "value": "spring"
            }
          ],
          "media": [
            "stage.room"
          ]
        },
        {
          "id": "summer-heat",
          "text": "In summer, the cheap room holds the heat for a long time, and people try not to block the way to the door. The night still passes under a roof, even without much comfort.",
          "conditions": [
            {
              "kind": "calendarSeason",
              "value": "summer"
            }
          ],
          "media": [
            "stage.room"
          ]
        },
        {
          "id": "winter-stove",
          "text": "In winter, the space around the small stove is always more crowded than usual. People dry gloves and shoes in turns, trying not to hold the warmth longer than needed.",
          "conditions": [
            {
              "kind": "calendarSeason",
              "value": "winter"
            }
          ],
          "media": [
            "stage.room"
          ]
        },
        {
          "id": "shared-room",
          "text": "The shared room runs on simple rules: keep the passage clear, avoid waking those already asleep, and keep belongings close. Those small habits make one night more predictable.",
          "conditions": [],
          "media": [
            "stage.room"
          ]
        }
      ],
      "choices": [
        {
          "id": "settle-in",
          "label": "Settle in",
          "text": "You keep your space tidy and let the shared room wind down. No extra cost or penalty is added by this context event.",
