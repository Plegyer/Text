            {
              "kind": "calendarSeason",
              "value": "winter"
            }
          ],
          "media": [
            "stage.room"
          ]
        },
        {
          "id": "shared-room",
          "text": "The cheap shared room is plain and crowded, but it is still a roof, a door, and a place to sleep without adding another street-night risk.",
          "conditions": [],
          "media": [
            "stage.room"
          ]
        }
      ],
