        {
          "kind": "careerFact",
          "career": "artist-geisha",
          "fact": "master-artist-ready",
          "present": false
        }
      ],
      "variants": [
        {
          "id": "default",
          "text": "Arts & Performance helps formulate stage intention, work with rhythm, and respond to a partner. This text selects no numeric threshold, publishes no new School fact, and invents no separate music, dance, or craft course.\n\nLiteracy & Numbers helps keep program, booking, and rehearsal notes so the next shift can rely on a record. It creates no new accounting subsystem and selects no School threshold.\n\nMaster Artist is depth of professional preparation: clear intention, repeatable rehearsal, usable records, and the ability to explain one's choices. It is not a universal ranking of artistic worth.\n\nThe Master Artist route does not choose an exact list of music, dance, craft, or other disciplines for the project. It describes quality of process on top of the existing Arts & Performance preparation.",
          "conditions": [],
          "media": []
        }
      ],
      "choices": [
        {
          "id": "record",
          "label": "Record Master Artist readiness",
          "text": "Keep this performance-and-education route ready without committing to it.",
          "conditions": [],
          "effects": [
            {
              "kind": "addCareerFact",
              "career": "artist-geisha",
              "fact": "master-artist-ready"
            }
          ]
        }
      ]
