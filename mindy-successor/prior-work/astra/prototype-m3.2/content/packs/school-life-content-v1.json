        },
        {
          "id": "rhetoric",
          "text": "You quietly rehearse several ways to open the same conversation.",
          "conditions": [],
          "media": [
            "school.life.classroom.default"
          ]
        },
        {
          "id": "etiquette",
          "text": "You practice introductions, posture and preparation in a quiet room.",
          "conditions": [],
          "media": [
            "school.life.classroom.default"
          ]
        },
        {
          "id": "field",
          "text": "You sort route notes, knots and sketches before sleep.",
          "conditions": [],
          "media": [
            "school.life.classroom.default"
          ]
        },
        {
          "id": "physical",
          "text": "You review controlled form and mobility instead of attempting another full workout.",
          "conditions": [],
          "media": [
            "school.life.classroom.default"
          ]
        },
        {
          "id": "arts",
          "text": "You repeat a short phrase, step or sketch until one choice begins to feel intentional.",
          "conditions": [],
          "media": [
            "school.life.classroom.default"
          ]
        },
        {
          "id": "body",
          "text": "You settle into a calm grooming or movement routine focused on deliberate self-care.",
          "conditions": [],
          "media": [
            "school.life.classroom.default"
          ]
        }
      ],
      "choices": [
        {
