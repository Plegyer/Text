      ],
      "variants": [
        {
          "id": "default",
          "text": "Trusted Service means being asked to follow a problem across desks instead of solving only the piece in front of you. A delayed record changes a route; a careless route changes an audience; an unclear audience changes who is held responsible. The Palace is testing breadth in practice now, not on paper. A life of service becomes imaginable, but the institution's protected purpose is still withheld.",
          "conditions": [],
          "media": []
        }
      ],
