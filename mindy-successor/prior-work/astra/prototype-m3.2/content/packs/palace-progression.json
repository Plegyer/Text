          "fact": "milestone-02-resolved",
          "present": false
        }
      ],
      "variants": [
        {
          "id": "default",
          "text": "By the second duty, coincidence stops looking like coincidence. Offices that handle different work use the same case marks, the same handoff notation, and the same habit of recording who knew what, and when. You can see the shape of a shared system. What that system is ultimately protecting remains outside your clearance.",
          "conditions": [],
          "media": []
        }
      ],
      "choices": [
        {
          "id": "continue",
          "label": "Continue",
          "text": "You acknowledge what the work has established and continue from the stage already committed.",
          "conditions": [],
          "effects": [
            {
              "kind": "addCareerFact",
              "career": "palace",
              "fact": "milestone-02-resolved"
            }
          ]
        }
      ]
    },
    {
