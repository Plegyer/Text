    {
      "id": "hunter.career.first-shift",
      "title": "The first reliable return",
      "sourceDomain": "hunter",
      "trigger": [],
      "reactionTriggers": [
        {
          "kind": "careerCounterChanged",
          "career": "hunter",
          "counter": "completed_shifts"
        }
      ],
      "priorityClass": "critical_progression",
      "priority": 100,
      "blocking": true,
      "delivery": {
        "policy": "live"
      },
      "cooldownDays": 0,
      "variantCooldownDays": 0,
      "maxShows": 1,
      "conditions": [
        {
          "kind": "careerStage",
          "career": "hunter",
          "stage": "novice"
        },
        {
          "kind": "careerCounter",
          "career": "hunter",
          "counter": "completed_shifts",
          "op": "gte",
          "value": 1
        }
      ],
      "variants": [
        {
          "id": "street-survival",
          "text": "When you are sleeping rough, the first Hunter wage matters immediately, but the job does not erase the street-night rules. What changes is practical: you now have ordinary paid work you can return to without accepting a private rescue or hidden obligation.",
          "conditions": [
            {
              "kind": "housingTier",
              "value": "street"
            }
          ],
          "media": []
        },
        {
          "id": "cheap-budget",
          "text": "With a cheap shared room already taking part of the budget, the first Hunter wage feels concrete. The work remains ordinary paid work: it helps the next day without refunding lodging, changing its price, or creating a special housing entitlement.",
          "conditions": [
            {
              "kind": "housingTier",
              "value": "cheap"
            }
          ],
          "media": []
        },
        {
          "id": "default",
          "text": "The first completed local contract proves the basic discipline of the work: read enough sign to act, finish the agreed task, and return with notes another hunter can actually use.",
          "conditions": [],
          "media": []
        }
      ],
      "choices": [
        {
          "id": "continue",
          "label": "Take tracker work",
          "text": "Move into regular tracking work while keeping ordinary shifts distinct from the separate expedition layer.",
          "conditions": [],
          "effects": [
            {
              "kind": "advanceCareer",
              "career": "hunter",
              "transition": "first-shift"
            }
          ]
        }
      ]
    },
