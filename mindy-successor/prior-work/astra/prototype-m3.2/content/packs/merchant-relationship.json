  "events": [
    {
      "id": "merchant.relationship.intro",
      "title": "A recurring supplier starts recognizing your working habits",
      "sourceDomain": "merchant",
      "trigger": [],
      "reactionTriggers": [
        {
          "kind": "actionCompleted",
          "action": "merchant.shift"
        }
      ],
      "priorityClass": "normal_progression",
      "priority": 73,
      "blocking": true,
      "delivery": {
        "policy": "live"
      },
      "cooldownDays": 0,
      "variantCooldownDays": 0,
      "maxShows": 1,
      "conditions": [
        {
          "kind": "not",
          "condition": {
            "kind": "careerStage",
            "career": "merchant",
            "stage": "stall-hand"
          }
        },
        {
          "kind": "relationshipFact",
          "relationship": "merchant.supplier",
          "fact": "introduced-at-work",
          "present": false
        }
      ],
      "variants": [
        {
          "id": "default",
          "text": "A recurring supplier becomes familiar not through personal closeness but because you keep meeting through work. The first rule is simple: promise only what can be checked and delivered.",
          "conditions": [],
          "media": []
        }
      ],
      "choices": [
        {
          "id": "professional",
          "label": "Keep the contact professional",
          "text": "Record the first reliable work contact.",
          "conditions": [],
          "effects": [
            {
              "kind": "addRelationshipFact",
              "relationship": "merchant.supplier",
              "fact": "introduced-at-work"
            },
            {
              "kind": "incrementRelationshipCounter",
              "relationship": "merchant.supplier",
              "counter": "work-meetings",
              "amount": 1
            }
          ]
        }
      ]
    },
    {
      "id": "merchant.relationship.trust",
      "title": "Professional supplier trust",
      "sourceDomain": "merchant",
      "trigger": [],
      "reactionTriggers": [
        {
          "kind": "actionCompleted",
          "action": "merchant.shift"
        }
      ],
      "priorityClass": "normal_progression",
      "priority": 72,
      "blocking": true,
      "delivery": {
        "policy": "live"
      },
      "cooldownDays": 0,
      "variantCooldownDays": 0,
      "maxShows": 1,
      "conditions": [
        {
          "kind": "relationshipStage",
          "relationship": "merchant.supplier",
          "stage": "introduced"
        },
        {
          "kind": "relationshipFact",
          "relationship": "merchant.supplier",
          "fact": "introduced-at-work",
          "present": true
        },
        {
          "kind": "relationshipCounter",
          "relationship": "merchant.supplier",
          "counter": "work-meetings",
          "op": "eq",
          "value": 1
        }
      ],
      "variants": [
        {
          "id": "default",
          "text": "Professional trust grows from accurate timing, honest warnings, and records that can be revisited. You do not require friendship in exchange for reliability or promise privileges in exchange for goodwill.\n\nRhetoric practice teaches you to find out whether a buyer objects to price, timing, risk, or trust before making a concession. It guarantees no discount, bargaining victory, or automatic relationship change.",
          "conditions": [],
          "media": []
        }
      ],
      "choices": [
        {
          "id": "apply-rhetoric-method",
          "label": "Use the prepared negotiation method",
          "text": "Ask what is actually blocking the deal before changing terms; this consumes only the Merchant-local School fact.",
          "conditions": [
            {
              "kind": "careerFact",
              "career": "merchant",
              "fact": "school-rhetoric-ready",
              "present": true
            }
          ],
          "effects": [
            {
              "kind": "incrementRelationshipCounter",
              "relationship": "merchant.supplier",
              "counter": "work-meetings",
              "amount": 1
            },
            {
              "kind": "incrementCareerCounter",
              "career": "merchant",
              "counter": "supplier_meetings",
              "amount": 1
            },
            {
              "kind": "advanceRelationship",
              "relationship": "merchant.supplier",
              "transition": "build-trust"
            },
            {
              "kind": "addCareerFact",
              "career": "merchant",
              "fact": "supplier-trust-ready"
            }
          ]
        },
        {
          "id": "continue",
          "label": "Keep the reliable contact",
          "text": "Build professional trust through another verifiable handoff.",
          "conditions": [],
          "effects": [
            {
              "kind": "incrementRelationshipCounter",
              "relationship": "merchant.supplier",
              "counter": "work-meetings",
              "amount": 1
            },
            {
              "kind": "incrementCareerCounter",
              "career": "merchant",
              "counter": "supplier_meetings",
              "amount": 1
            },
            {
              "kind": "advanceRelationship",
              "relationship": "merchant.supplier",
              "transition": "build-trust"
            },
            {
              "kind": "addCareerFact",
              "career": "merchant",
              "fact": "supplier-trust-ready"
            }
          ]
        }
      ]
    },
    {
      "id": "merchant.relationship.conflict-open",
      "title": "A supplier conflict over timing and responsibility",
      "sourceDomain": "merchant",
      "trigger": [],
      "reactionTriggers": [
        {
          "kind": "relationshipTransition",
          "relationship": "merchant.supplier"
        },
        {
          "kind": "actionCompleted",
          "action": "merchant.shift"
        }
      ],
      "priorityClass": "normal_progression",
      "priority": 71,
      "blocking": true,
      "delivery": {
        "policy": "live"
      },
      "cooldownDays": 0,
      "variantCooldownDays": 0,
      "maxShows": 1,
      "conditions": [
        {
          "kind": "relationshipStage",
          "relationship": "merchant.supplier",
          "stage": "professional-trust"
        },
        {
          "kind": "relationshipFact",
          "relationship": "merchant.supplier",
          "fact": "conflict-opened",
          "present": false
        }
      ],
      "variants": [
        {
          "id": "default",
          "text": "A lot arrived differently from what was agreed, and the dispute could easily become personal. You return the conversation to timing, cargo condition, and what can be corrected in the next delivery.",
          "conditions": [],
          "media": []
        }
      ],
      "choices": [
        {
          "id": "open",
          "label": "State the disagreement clearly",
          "text": "Move the dispute into an explicit professional state.",
          "conditions": [],
          "effects": [
            {
              "kind": "addRelationshipFact",
              "relationship": "merchant.supplier",
              "fact": "conflict-opened"
            },
            {
              "kind": "advanceRelationship",
              "relationship": "merchant.supplier",
              "transition": "open-conflict"
            }
          ]
        }
      ]
    },
    {
      "id": "merchant.relationship.conflict-resolve",
      "title": "Resolve the supplier conflict",
      "sourceDomain": "merchant",
      "trigger": [],
      "reactionTriggers": [
        {
          "kind": "relationshipTransition",
          "relationship": "merchant.supplier"
        },
        {
          "kind": "actionCompleted",
          "action": "merchant.shift"
        }
      ],
      "priorityClass": "critical_progression",
      "priority": 84,
      "blocking": true,
      "delivery": {
        "policy": "live"
      },
      "cooldownDays": 0,
      "variantCooldownDays": 0,
      "maxShows": 1,
      "conditions": [
        {
          "kind": "relationshipStage",
          "relationship": "merchant.supplier",
          "stage": "conflict-open"
        }
      ],
      "variants": [
        {
          "id": "default",
          "text": "Cooperation does not mean permanent agreement; it means having a clear way to correct mistakes. You confirm a new checking routine and leave both sides free to decline a trade that no longer fits.\n\nProfessional rivalry can make both sides more precise about timing and quality when it is not turned into sabotage. You compare offers by evidence and do not demand exclusivity.\n\nThe supplier declines an additional arrangement, and that does not close the career. You respect the boundary, keep the working terms that still fit, and ordinary Merchant shifts continue.",
          "conditions": [],
          "media": []
        }
      ],
      "choices": [
        {
          "id": "cooperate",
          "label": "Build a clearer handoff",
          "text": "Agree on records and responsibility for future deliveries.",
          "conditions": [],
          "effects": [
            {
              "kind": "setRelationshipChoice",
              "relationship": "merchant.supplier",
              "choice": "conflict-response",
              "value": "cooperate"
            },
            {
              "kind": "addCareerFact",
              "career": "merchant",
              "fact": "relationship-conflict-resolved"
            },
            {
              "kind": "advanceRelationship",
              "relationship": "merchant.supplier",
              "transition": "cooperate"
            }
          ]
        },
        {
          "id": "rivalry",
          "label": "Remain professional rivals",
          "text": "Keep comparing offers and standards without blocking ordinary work.",
          "conditions": [],
          "effects": [
            {
              "kind": "setRelationshipChoice",
              "relationship": "merchant.supplier",
              "choice": "conflict-response",
              "value": "rivalry"
            },
            {
              "kind": "addCareerFact",
              "career": "merchant",
              "fact": "relationship-conflict-resolved"
            },
            {
              "kind": "advanceRelationship",
              "relationship": "merchant.supplier",
              "transition": "rivalry"
            }
          ]
        },
        {
          "id": "decline",
          "label": "End the extra supplier route",
          "text": "Refuse deeper coordination; keep the career and ordinary shifts intact.",
          "conditions": [],
          "effects": [
            {
              "kind": "setRelationshipChoice",
              "relationship": "merchant.supplier",
              "choice": "conflict-response",
              "value": "declined"
            },
            {
              "kind": "addCareerFact",
              "career": "merchant",
              "fact": "relationship-conflict-resolved"
            },
            {
              "kind": "advanceRelationship",
              "relationship": "merchant.supplier",
              "transition": "refusal"
            }
          ]
        }
      ]
    },
    {
      "id": "merchant.relationship.utility",
      "title": "Optional supplier utility after conflict",
      "sourceDomain": "merchant",
      "trigger": [],
      "reactionTriggers": [
        {
          "kind": "relationshipTransition",
          "relationship": "merchant.supplier"
        },
        {
          "kind": "actionCompleted",
          "action": "merchant.shift"
        }
      ],
      "priorityClass": "normal_progression",
      "priority": 68,
      "blocking": true,
      "delivery": {
        "policy": "live"
      },
      "cooldownDays": 0,
      "variantCooldownDays": 0,
      "maxShows": 1,
      "conditions": [
        {
          "kind": "relationshipStage",
          "relationship": "merchant.supplier",
          "stage": "utility-ready"
        }
      ],
      "variants": [
        {
          "id": "default",
          "text": "A useful contact is not a free resource. The supplier may know which road is delayed or what quantity is realistic, but the decision to make a trade remains a separate professional choice.\n\nEven after several successful trades, agreements remain specific: lot, timing, condition, and method of verification. A good relationship does not remove the need to state the terms again.",
          "conditions": [],
          "media": []
        }
      ],
      "choices": [
        {
          "id": "accept",
          "label": "Keep the checked handoff available",
          "text": "Record one later-use relationship fact.",
          "conditions": [],
          "effects": [
            {
              "kind": "setRelationshipChoice",
              "relationship": "merchant.supplier",
              "choice": "utility-response",
              "value": "accepted"
            },
            {
              "kind": "incrementRelationshipCounter",
              "relationship": "merchant.supplier",
              "counter": "delivery-meetings",
              "amount": 1
            },
            {
              "kind": "addRelationshipFact",
              "relationship": "merchant.supplier",
              "fact": "utility-response-resolved"
            },
            {
              "kind": "addCareerFact",
              "career": "merchant",
              "fact": "relationship-utility-ready"
            },
            {
              "kind": "advanceRelationship",
              "relationship": "merchant.supplier",
              "transition": "finish-utility"
            }
          ]
        },
        {
          "id": "decline",
          "label": "Keep deliveries independent",
          "text": "Decline the utility without losing ordinary work or earned professional trust.",
          "conditions": [],
          "effects": [
            {
              "kind": "setRelationshipChoice",
              "relationship": "merchant.supplier",
              "choice": "utility-response",
              "value": "declined"
            },
            {
              "kind": "addRelationshipFact",
              "relationship": "merchant.supplier",
              "fact": "refusal-respected"
            },
            {
              "kind": "addRelationshipFact",
              "relationship": "merchant.supplier",
              "fact": "utility-response-resolved"
            },
            {
              "kind": "advanceRelationship",
              "relationship": "merchant.supplier",
              "transition": "finish-utility"
            }
          ]
        }
      ]
    }
  ]
