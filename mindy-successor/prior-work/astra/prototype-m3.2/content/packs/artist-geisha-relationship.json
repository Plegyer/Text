          "id": "default",
          "text": "Later mentor utility is narrow help: notice a weak transition, warn about the shape of an evening, or suggest what to check before an entrance. It grants no universal access, status, or guaranteed success.",
          "conditions": [],
          "media": []
        }
      ],
      "choices": [
        {
          "id": "accept",
          "label": "Use the professional review",
          "text": "Accept one optional rehearsal review without making mentorship compulsory.",
          "conditions": [],
          "effects": [
            {
              "kind": "setRelationshipChoice",
