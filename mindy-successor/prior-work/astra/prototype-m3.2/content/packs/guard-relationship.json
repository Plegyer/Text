            }
          ]
        },
        {
          "id": "decline",
          "label": "Work independently",
          "text": "Decline partner case support without losing trust or ordinary Guard work.",
          "conditions": [],
          "effects": [
            {
              "kind": "setRelationshipChoice",
              "relationship": "guard.partner",
              "choice": "cooperation-response",
              "value": "declined"
            },
            {
              "kind": "addRelationshipFact",
              "relationship": "guard.partner",
              "fact": "refusal-respected"
            },
            {
              "kind": "addRelationshipFact",
              "relationship": "guard.partner",
              "fact": "case-support-ready"
            },
            {
              "kind": "advanceRelationship",
              "relationship": "guard.partner",
              "transition": "finish-cooperation"
            }
          ]
        }
      ]
