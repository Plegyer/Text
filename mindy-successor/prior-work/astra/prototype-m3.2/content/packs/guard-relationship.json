      "variantCooldownDays": 0,
      "maxShows": 1,
      "conditions": [
        {
          "kind": "relationshipStage",
          "relationship": "guard.partner",
          "stage": "cooperation-ready"
        }
      ],
      "variants": [
        {
          "id": "default",
          "text": "If cooperation continues, the partner can provide a second verifiable line for a major case: confirming a handoff, checking a report, or noticing a mismatch. That is source support, not a mandatory key to the career.",
