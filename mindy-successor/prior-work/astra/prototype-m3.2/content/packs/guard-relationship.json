  "events": [
    {
      "id": "guard.relationship.intro",
      "title": "A partner starts checking your reports",
      "sourceDomain": "guard",
      "trigger": [],
      "reactionTriggers": [
        {
          "kind": "actionCompleted",
          "action": "guard.shift"
        }
      ],
      "priorityClass": "normal_progression",
      "priority": 72,
      "blocking": true,
      "delivery": {
        "policy": "live"
      },
      "cooldownDays": 0,
      "variantCooldownDays": 0,
      "maxShows": 1,
      "conditions": [
        {
          "kind": "not",
          "condition": {
            "kind": "careerStage",
            "career": "guard",
            "stage": "recruit"
          }
        },
        {
          "kind": "relationshipFact",
          "relationship": "guard.partner",
          "fact": "introduced-at-work",
          "present": false
        }
      ],
      "variants": [
        {
          "id": "default",
          "text": "The partner enters as a colleague on duty: comparing notes, sharing an area, and noticing where your working methods differ. The role remains unnamed and assumes neither friendship, romance, nor mandatory personal trust.",
          "conditions": [],
          "media": []
        }
      ],
      "choices": [
        {
          "id": "professional",
          "label": "Compare reports",
          "text": "Keep the first contact practical and non-romantic.",
          "conditions": [],
          "effects": [
            {
              "kind": "addRelationshipFact",
              "relationship": "guard.partner",
              "fact": "introduced-at-work"
            },
            {
              "kind": "incrementRelationshipCounter",
              "relationship": "guard.partner",
              "counter": "work-meetings",
              "amount": 1
            }
          ]
        }
      ]
    },
    {
      "id": "guard.relationship.trust",
      "title": "Professional trust",
      "sourceDomain": "guard",
      "trigger": [],
      "reactionTriggers": [
        {
          "kind": "actionCompleted",
          "action": "guard.shift"
        }
      ],
      "priorityClass": "normal_progression",
      "priority": 71,
      "blocking": true,
      "delivery": {
        "policy": "live"
      },
      "cooldownDays": 0,
      "variantCooldownDays": 0,
      "maxShows": 1,
      "conditions": [
        {
          "kind": "relationshipStage",
          "relationship": "guard.partner",
          "stage": "introduced"
        },
        {
          "kind": "relationshipFact",
          "relationship": "guard.partner",
          "fact": "introduced-at-work",
          "present": true
        },
        {
          "kind": "relationshipCounter",
          "relationship": "guard.partner",
          "counter": "work-meetings",
          "op": "eq",
          "value": 1
        }
      ],
      "variants": [
        {
          "id": "default",
          "text": "Professional trust grows from repeatable details: arriving for handoff on time, not claiming someone else's observation, and saying plainly where uncertainty remains. That is enough for a working relationship without personal intimacy.",
          "conditions": [],
          "media": []
        }
      ],
      "choices": [
        {
          "id": "continue",
          "label": "Keep the professional contact",
          "text": "Build trust without committing to friendship, rivalry, or special favors.",
          "conditions": [],
          "effects": [
            {
              "kind": "incrementRelationshipCounter",
              "relationship": "guard.partner",
              "counter": "work-meetings",
              "amount": 1
            },
            {
              "kind": "advanceRelationship",
              "relationship": "guard.partner",
              "transition": "build-trust"
            },
            {
              "kind": "addCareerFact",
              "career": "guard",
              "fact": "relationship-trust-ready"
            }
          ]
        }
      ]
    },
    {
      "id": "guard.relationship.conflict-open",
      "title": "A professional conflict",
      "sourceDomain": "guard",
      "trigger": [],
      "reactionTriggers": [
        {
          "kind": "relationshipTransition",
          "relationship": "guard.partner"
        },
        {
          "kind": "actionCompleted",
          "action": "guard.shift"
        }
      ],
      "priorityClass": "normal_progression",
      "priority": 70,
      "blocking": true,
      "delivery": {
        "policy": "live"
      },
      "cooldownDays": 0,
      "variantCooldownDays": 0,
      "maxShows": 1,
      "conditions": [
        {
          "kind": "relationshipStage",
          "relationship": "guard.partner",
          "stage": "professional-trust"
        },
        {
          "kind": "relationshipFact",
          "relationship": "guard.partner",
          "fact": "conflict-opened",
          "present": false
        }
      ],
      "variants": [
        {
          "id": "default",
          "text": "The conflict comes from a different case decision rather than abstract dislike: delay a check, open a passage, accept testimony, or require another record. The disagreement is about practice and responsibility.",
          "conditions": [],
          "media": []
        }
      ],
      "choices": [
        {
          "id": "open",
          "label": "State the disagreement clearly",
          "text": "Move the conflict into an explicit relationship state instead of a hidden affinity score.",
          "conditions": [],
          "effects": [
            {
              "kind": "addRelationshipFact",
              "relationship": "guard.partner",
              "fact": "conflict-opened"
            },
            {
              "kind": "advanceRelationship",
              "relationship": "guard.partner",
              "transition": "open-conflict"
            }
          ]
        }
      ]
    },
    {
      "id": "guard.relationship.conflict-resolve",
      "title": "Resolve the Guard conflict",
      "sourceDomain": "guard",
      "trigger": [],
      "reactionTriggers": [
        {
          "kind": "relationshipTransition",
          "relationship": "guard.partner"
        },
        {
          "kind": "actionCompleted",
          "action": "guard.shift"
        }
      ],
      "priorityClass": "critical_progression",
      "priority": 82,
      "blocking": true,
      "delivery": {
        "policy": "live"
      },
      "cooldownDays": 0,
      "variantCooldownDays": 0,
      "maxShows": 1,
      "conditions": [
        {
          "kind": "relationshipStage",
          "relationship": "guard.partner",
          "stage": "conflict-open"
        }
      ],
      "variants": [
        {
          "id": "default",
          "text": "The conflict can become cooperation, professional rivalry, or a clean refusal to take the relationship route further.",
          "conditions": [],
          "media": []
        }
      ],
      "choices": [
        {
          "id": "cooperate",
          "label": "Build a documented compromise",
          "text": "Cooperation after conflict does not mean total agreement; it means a clear way to review each other's decisions. Partners can divide the work and leave a written trail of where they agreed and where they did not.",
          "conditions": [],
          "effects": [
            {
              "kind": "setRelationshipChoice",
              "relationship": "guard.partner",
              "choice": "conflict-response",
              "value": "cooperate"
            },
            {
              "kind": "addCareerFact",
              "career": "guard",
              "fact": "relationship-conflict-resolved"
            },
            {
              "kind": "advanceRelationship",
              "relationship": "guard.partner",
              "transition": "cooperate"
            }
          ]
        },
        {
          "id": "rivalry",
          "label": "Remain professional rivals",
          "text": "Professional rivalry can remain useful: each Guard demands cleaner records and better-supported decisions from the other. It does not block ordinary shifts or become a hidden relationship meter.",
          "conditions": [],
          "effects": [
            {
              "kind": "setRelationshipChoice",
              "relationship": "guard.partner",
              "choice": "conflict-response",
              "value": "rivalry"
            },
            {
              "kind": "addCareerFact",
              "career": "guard",
              "fact": "relationship-conflict-resolved"
            },
            {
              "kind": "advanceRelationship",
              "relationship": "guard.partner",
              "transition": "rivalry"
            }
          ]
        },
        {
          "id": "decline",
          "label": "Step away from the extra relationship route",
          "text": "Refusing additional joint work should be clean. The partner respects the boundary, ordinary shifts continue, and previously earned professional trust is not erased as punishment for saying no.",
          "conditions": [],
          "effects": [
            {
              "kind": "setRelationshipChoice",
              "relationship": "guard.partner",
              "choice": "conflict-response",
              "value": "declined"
            },
            {
              "kind": "addCareerFact",
              "career": "guard",
              "fact": "relationship-conflict-resolved"
            },
            {
              "kind": "advanceRelationship",
              "relationship": "guard.partner",
              "transition": "refusal"
            }
          ]
        }
      ]
    },
    {
