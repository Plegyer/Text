      ],
      "variants": [
        {
          "id": "street",
          "text": "After the shift, ordinary staff food remains, and tonight there is enough for you to eat before leaving. It is help in kind, not a free room; your lodging choice and its ordinary consequences remain separate.",
          "conditions": [
            {
              "kind": "housingTier",
              "value": "street"
            }
          ],
          "media": []
        },
        {
          "id": "cheap",
          "text": "When the day's budget and a cheap room have already taken most of what you can spare, a meal after the shift makes the evening easier. It does not refund the room or change lodging prices; it simply means one practical need is covered tonight.",
          "conditions": [
            {
              "kind": "housingTier",
              "value": "cheap"
            }
          ],
          "media": []
        },
        {
          "id": "default",
          "text": "Tavern assistance has clear limits: a meal after work or one practical accommodation does not become a permanent entitlement to housing. That keeps the help useful without erasing the ordinary lodging economy.",
          "conditions": [],
          "media": []
        }
      ],
      "choices": [
        {
          "id": "accept-meal",
          "label": "Accept the staff meal",
          "text": "Nobody asks for a personal favor, hidden debt, or promise in exchange for the help. The support stays inside clear house rules and can end without putting your career or relationships at stake.",
          "conditions": [],
          "effects": [
            {
              "kind": "addCareerFact",
              "career": "tavern",
              "fact": "housing-assistance-complete"
            }
          ]
        },
        {
          "id": "decline-meal",
          "label": "Decline the meal",
          "text": "Keep the work relationship unchanged and continue using ordinary housing choices.",
          "conditions": [],
          "effects": [
            {
              "kind": "addCareerFact",
              "career": "tavern",
              "fact": "housing-assistance-declined"
            }
          ]
        }
      ]
    }
