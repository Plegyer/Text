  "events": [
    {
      "id": "gopher.arrival",
      "title": "Белый суслик и открытый люк",
      "trigger": [
        "arrival"
      ],
      "priority": 100,
      "cooldownDays": 0,
      "variantCooldownDays": 0,
      "maxShows": 1,
      "conditions": [
        {
          "kind": "flag",
          "key": "story.arrived",
          "value": false
        }
      ],
      "variants": [
        {
          "id": "default",
          "text": "В обычном городе вы замечаете белого суслика с золотой пуговицей в зубах. Он оглядывается так возмущённо, словно опаздываете именно вы. Погоня заканчивается открытым люком — и падением в телегу с сеном под незнакомым небом. Вокруг эльфы, орки и сатиры. Женщин среди них нет: по словам возницы, их не видели уже много поколений. Молодой на вид эльф представляется принцем Элианом и слишком быстро предлагает защиту. Старик-сатир Силан предлагает комнату. «Комната есть. Плата — монетами или помощью по хозяйству». Вам 25 лет, и это определённо не лучший способ сменить адрес.",
          "conditions": [],
          "media": [
            "gopher.arrival.default"
          ]
        }
      ],
      "choices": [
        {
          "id": "home",
          "label": "Сначала найти дорогу домой",
          "text": "Вы решаете искать путь назад, но другие цели остаются открыты.",
          "effects": [
            {
              "kind": "flag",
              "key": "story.arrived",
              "value": true
            },
            {
              "kind": "flag",
              "key": "story.home",
              "value": true
            }
          ],
          "conditions": []
        },
        {
          "id": "status",
          "label": "Для начала устроиться получше",
          "text": "Внимание можно превратить в связи, доход и самостоятельность.",
          "effects": [
            {
              "kind": "flag",
              "key": "story.arrived",
              "value": true
            },
            {
              "kind": "flag",
              "key": "story.status",
              "value": true
            }
          ],
          "conditions": []
        },
        {
          "id": "mystery",
          "label": "Узнать, что случилось с этим миром",
          "text": "Вы запоминаете странную паузу принца при вопросе о женщинах.",
          "effects": [
            {
              "kind": "flag",
              "key": "story.arrived",
              "value": true
            },
            {
              "kind": "flag",
              "key": "story.mystery",
              "value": true
            }
          ],
          "conditions": []
        }
      ]
    },
    {
      "id": "gopher.tavern-intro",
      "title": "Кружки прежде легенд",
      "trigger": [
        "tavern"
      ],
      "priority": 90,
      "cooldownDays": 0,
      "variantCooldownDays": 0,
      "maxShows": 1,
      "conditions": [
        {
          "kind": "flag",
          "key": "tavern.met",
          "value": false
        }
      ],
      "variants": [
        {
          "id": "default",
          "text": "Трактирщик Марек, широкоплечий орк тридцати четырёх лет, выдаёт вам фартук. «Гости уже спорят, кто спасёт вас от дракона. Пока пусть спасут мебель от локтей». Вы договариваетесь: комплименты принимаются, хватать персонал нельзя. Первая смена начинается с трёх заказов и одной дуэли за право вымыть пол.",
          "conditions": [],
          "media": [
            "gopher.tavern-intro.default"
          ]
        }
      ],
      "choices": [
        {
          "id": "agree",
          "label": "Договориться о правилах",
          "text": "Марек поддержал ваши условия. Здесь можно работать спокойно.",
          "effects": [
            {
              "kind": "flag",
              "key": "tavern.met",
              "value": true
            }
          ],
          "conditions": []
        }
      ]
    },
    {
      "id": "gopher.tavern-quest",
      "title": "Пропавшая накладная",
      "trigger": [
        "tavern"
      ],
      "priority": 80,
      "cooldownDays": 1,
      "variantCooldownDays": 1,
      "maxShows": 30,
      "conditions": [
        {
          "kind": "flag",
          "key": "tavern.met",
          "value": true
        },
        {
          "kind": "flag",
          "key": "tavern.quest",
          "value": false
