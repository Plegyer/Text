      ],
      "variants": [
        {
          "id": "default",
          "text": "The senior guide wants to push a pressured route; your reading suggests protection, delay, or a narrower contract. The conflict is about field judgment and responsibility, not a hidden morality score.",
          "conditions": [],
          "media": []
        }
      ],
      "choices": [
        {
          "id": "open",
          "label": "State the field disagreement",
          "text": "Make the route conflict explicit so the next beat can resolve it as cooperation, rivalry, or refusal.",
          "conditions": [],
          "effects": [
            {
              "kind": "addRelationshipFact",
              "relationship": "hunter.senior-guide",
              "fact": "conflict-opened"
            },
            {
              "kind": "advanceRelationship",
              "relationship": "hunter.senior-guide",
              "transition": "open-conflict"
            }
          ]
        }
      ]
    },
