    {
      "id": "hunter.relationship.intro",
      "title": "A senior guide checks the handoff",
      "sourceDomain": "hunter",
      "trigger": [],
      "reactionTriggers": [
        {
          "kind": "actionCompleted",
          "action": "hunter.shift"
        }
      ],
      "priorityClass": "normal_progression",
      "priority": 74,
      "blocking": true,
      "delivery": {
        "policy": "live"
      },
      "cooldownDays": 0,
      "variantCooldownDays": 0,
      "maxShows": 1,
      "conditions": [
        {
          "kind": "not",
          "condition": {
            "kind": "careerStage",
            "career": "hunter",
            "stage": "novice"
          }
        },
        {
          "kind": "relationshipFact",
          "relationship": "hunter.senior-guide",
          "fact": "introduced-at-work",
          "present": false
        }
      ],
      "variants": [
        {
          "id": "client-handoff",
          "text": "A client has brought a route question that matches information you already carried from town. A senior hunter checks your notes before either of you answers, keeping the client relationship practical rather than turning it into a private obligation.",
          "conditions": [
            {
              "kind": "careerFact",
              "career": "hunter",
              "fact": "tavern-clue-known",
              "present": true
            }
          ],
          "media": []
        },
        {
          "id": "forest-local-context",
          "text": "A forest-edge local has flagged a change near the route already recorded in your Hunter notes. The senior guide compares your field record with that local observation; the local remains a source, not a mandatory companion or named canon character.",
          "conditions": [
            {
              "kind": "careerFact",
              "career": "hunter",
              "fact": "forest-clue-known",
              "present": true
            }
          ],
          "media": []
        },
        {
          "id": "default",
          "text": "A senior hunter starts treating your route notes as professional material worth checking. The role can be mentor, guide, colleague, or later rival; it stays unnamed and never requires friendship or romance.",
          "conditions": [],
          "media": []
        }
      ],
      "choices": [
        {
          "id": "professional",
          "label": "Compare the route notes",
          "text": "Keep the first contact professional and useful without promising a personal relationship.",
          "conditions": [],
          "effects": [
            {
              "kind": "addRelationshipFact",
              "relationship": "hunter.senior-guide",
              "fact": "introduced-at-work"
            },
            {
              "kind": "incrementRelationshipCounter",
              "relationship": "hunter.senior-guide",
              "counter": "work-meetings",
              "amount": 1
            }
          ]
        }
      ]
    },
    {
      "id": "hunter.relationship.trust",
      "title": "Professional trust becomes familiar",
      "sourceDomain": "hunter",
      "trigger": [],
      "reactionTriggers": [
        {
          "kind": "actionCompleted",
          "action": "hunter.shift"
        }
      ],
      "priorityClass": "normal_progression",
      "priority": 73,
      "blocking": true,
      "delivery": {
        "policy": "live"
      },
      "cooldownDays": 0,
      "variantCooldownDays": 0,
      "maxShows": 1,
      "conditions": [
        {
          "kind": "relationshipStage",
          "relationship": "hunter.senior-guide",
          "stage": "introduced"
        },
        {
          "kind": "relationshipFact",
          "relationship": "hunter.senior-guide",
          "fact": "introduced-at-work",
          "present": true
        },
        {
          "kind": "relationshipCounter",
          "relationship": "hunter.senior-guide",
          "counter": "work-meetings",
          "op": "eq",
          "value": 1
        }
      ],
      "variants": [
        {
          "id": "default",
          "text": "After repeated ordinary work, the senior guide trusts your notes enough to challenge them directly. That familiarity can stay professional, grow into friendship, or later become rivalry; none of those tones is required for Hunter progression.",
          "conditions": [],
          "media": []
        }
      ],
      "choices": [
        {
          "id": "continue",
          "label": "Keep the working trust",
          "text": "Build professional trust while leaving friendship, rivalry, and expedition companionship optional.",
          "conditions": [],
          "effects": [
            {
              "kind": "incrementRelationshipCounter",
              "relationship": "hunter.senior-guide",
              "counter": "work-meetings",
              "amount": 1
            },
            {
              "kind": "advanceRelationship",
              "relationship": "hunter.senior-guide",
              "transition": "build-trust"
            },
            {
              "kind": "addCareerFact",
              "career": "hunter",
              "fact": "relationship-trust-ready"
            }
          ]
        }
      ]
    },
    {
