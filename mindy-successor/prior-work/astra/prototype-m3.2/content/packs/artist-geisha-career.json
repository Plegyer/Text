          "id": "default",
          "text": "The Artist/Geisha career has a complete late-route state. Hard Work remains independently eligible and complex public endings remain unassigned.",
          "conditions": [],
          "media": []
        }
      ],
      "choices": [
        {
          "id": "continue",
          "label": "Keep living",
          "text": "Move to outcome-ready without auto-committing an ending.",
          "conditions": [],
          "effects": [
            {
              "kind": "advanceCareer",
