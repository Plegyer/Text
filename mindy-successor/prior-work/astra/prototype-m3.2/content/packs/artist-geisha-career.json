    {
      "id": "artist-geisha.career.choose-route",
      "title": "Choose a late Artist House route",
      "sourceDomain": "artist-geisha",
      "trigger": [],
      "reactionTriggers": [
        {
          "kind": "careerFactAdded",
          "career": "artist-geisha",
          "fact": "veteran-ready"
        },
        {
          "kind": "careerFactAdded",
          "career": "artist-geisha",
          "fact": "master-artist-ready"
        },
        {
          "kind": "careerFactAdded",
          "career": "artist-geisha",
          "fact": "patron-network-ready"
        },
        {
          "kind": "careerFactAdded",
          "career": "artist-geisha",
          "fact": "court-invitation-ready"
        },
        {
          "kind": "actionCompleted",
          "action": "artist-geisha.shift"
        }
      ],
      "priorityClass": "normal_progression",
      "priority": 58,
      "blocking": true,
      "delivery": {
        "policy": "live"
      },
      "cooldownDays": 1,
      "variantCooldownDays": 0,
      "maxShows": 12,
      "conditions": [
        {
          "kind": "careerStage",
          "career": "artist-geisha",
          "stage": "recognized-artist"
        },
        {
          "kind": "any",
          "conditions": [
            {
              "kind": "careerFact",
              "career": "artist-geisha",
              "fact": "veteran-ready",
              "present": true
            },
            {
              "kind": "careerFact",
              "career": "artist-geisha",
              "fact": "master-artist-ready",
              "present": true
            },
            {
              "kind": "careerFact",
              "career": "artist-geisha",
              "fact": "patron-network-ready",
              "present": true
            },
            {
              "kind": "careerFact",
              "career": "artist-geisha",
              "fact": "court-invitation-ready",
              "present": true
            }
          ]
        }
      ],
      "variants": [
        {
          "id": "default",
          "text": "If several late routes are ready, the decision can be deferred. Readiness remains a possibility while ordinary Artist House work stays available without mandatory branch selection.\n\nVeteran, Master Artist, Patron Network, and Court Invitation describe career readiness. None of these states is a new public ending by itself or grants a Meta reward.",
          "conditions": [],
          "media": []
        }
      ],
      "choices": [
        {
          "id": "veteran",
          "label": "Take Veteran",
          "text": "Veteran is the route of broad ordinary practice: seasons, guests, rehearsals, and repeatable ability to carry a shift without mandatory specialization. Its value is consistency rather than a title.\n\nVeteran readiness should reflect breadth of work already accumulated without forcing an immediate career change. The option can remain open while ordinary shifts continue.",
          "conditions": [
            {
              "kind": "careerFact",
              "career": "artist-geisha",
              "fact": "veteran-ready",
              "present": true
            }
          ],
          "effects": [
            {
              "kind": "advanceCareer",
              "career": "artist-geisha",
              "transition": "branch-veteran"
            },
            {
              "kind": "addCareerFact",
              "career": "artist-geisha",
              "fact": "outcome-ready"
            }
          ]
        },
        {
          "id": "master-artist",
          "label": "Take Master Artist",
          "text": "Master Artist is depth of professional preparation: clear intention, repeatable rehearsal, usable records, and the ability to explain one's choices. It is not a universal ranking of artistic worth.\n\nThe Master Artist route does not choose an exact list of music, dance, craft, or other disciplines for the project. It describes quality of process on top of the existing Arts & Performance preparation.",
          "conditions": [
            {
              "kind": "careerFact",
              "career": "artist-geisha",
              "fact": "master-artist-ready",
              "present": true
            }
          ],
          "effects": [
            {
              "kind": "advanceCareer",
              "career": "artist-geisha",
              "transition": "branch-master-artist"
            },
            {
              "kind": "addCareerFact",
              "career": "artist-geisha",
              "fact": "outcome-ready"
            },
            {
              "kind": "addCareerFact",
              "career": "artist-geisha",
              "fact": "ending-route-master-artist-selected"
            }
          ]
        },
        {
          "id": "patron-network",
          "label": "Take Patron Network",
          "text": "Patron Network is several durable professional contacts where context, expectations, and the next conversation are understood. The network does not become a separate influence currency or a global patron system.\n\nA useful contact may explain the shape of an evening or introduce one specific person, but guarantees no invitation, work, or success. Each next step remains a separate Artist situation.",
          "conditions": [
            {
              "kind": "careerFact",
              "career": "artist-geisha",
              "fact": "patron-network-ready",
              "present": true
            }
          ],
          "effects": [
            {
              "kind": "advanceCareer",
              "career": "artist-geisha",
              "transition": "branch-patron-network"
            },
            {
              "kind": "addCareerFact",
              "career": "artist-geisha",
              "fact": "outcome-ready"
            },
            {
              "kind": "addCareerFact",
              "career": "artist-geisha",
              "fact": "ending-route-patron-network-selected"
            }
          ]
        },
        {
          "id": "court-invitation",
          "label": "Take Court Invitation",
          "text": "Court Invitation is Artist-local evidence that a formal contact or invitation actually occurred. It describes career readiness for a formal context rather than access to the Palace.\n\nEven with an Invitation Token, the route remains narrow: show which invitation the token belongs to and what the specific event expects. The token is not a universal pass.\n\nNeither formal attire, invitation, nor court contact replaces the existing Palace 10/10 Hard Work unlock. Artist content neither writes nor satisfies that global gate.",
          "conditions": [
            {
              "kind": "careerFact",
              "career": "artist-geisha",
              "fact": "court-invitation-ready",
              "present": true
            }
          ],
          "effects": [
            {
              "kind": "advanceCareer",
              "career": "artist-geisha",
              "transition": "branch-court-invitation"
            },
            {
              "kind": "addCareerFact",
              "career": "artist-geisha",
              "fact": "outcome-ready"
            },
            {
              "kind": "addCareerFact",
              "career": "artist-geisha",
              "fact": "ending-route-court-invitation-selected"
            }
          ]
        },
        {
          "id": "defer",
          "label": "Keep routes open",
          "text": "If several late routes are ready, the decision can be deferred. Readiness remains a possibility while ordinary Artist House work stays available without mandatory branch selection.",
          "conditions": [],
          "effects": []
        }
      ]
    },
