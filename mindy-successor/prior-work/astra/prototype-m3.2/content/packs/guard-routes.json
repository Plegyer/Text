      "variants": [
        {
          "id": "default",
          "text": "The market compresses against a narrow gate: documents conflict, people are waiting, and each new decision changes the queue. The crisis requires a workable stabilization method, not a judgment about a 'good' or 'bad' Guard.",
          "conditions": [],
          "media": []
        }
      ],
      "choices": [
        {
          "id": "stabilize-by-report",
          "label": "Stabilize through the documented record",
          "text": "The report route relies on an auditable chain: who recorded the problem, which access was authorized, and which decision can be reviewed later. The point is reviewability, not greater severity.",
          "conditions": [
            {
              "kind": "careerFact",
              "career": "guard",
              "fact": "duty-report-evidence",
              "present": true
            },
            {
              "kind": "careerFact",
              "career": "guard",
              "fact": "official-access-issued",
              "present": true
            }
          ],
          "effects": [
            {
              "kind": "addCareerFact",
              "career": "guard",
              "fact": "crisis-resolved"
            },
            {
              "kind": "addCareerFact",
              "career": "guard",
              "fact": "crisis-officer"
            }
          ]
        },
        {
          "id": "deescalate-crowd",
          "label": "Resolve the pressure through de-escalation and relief routing",
          "text": "The de-escalation route changes immediate practice: restore movement, route people toward available assistance, and use what was learned from a resolved dispute. It is a concrete procedure, not a morality bonus.",
          "conditions": [
            {
              "kind": "careerFact",
              "career": "guard",
              "fact": "city-dispute-resolved",
              "present": true
            },
            {
              "kind": "careerFact",
