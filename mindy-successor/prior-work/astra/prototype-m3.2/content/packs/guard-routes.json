      "variants": [
        {
          "id": "default",
          "text": "The literacy-ready fact means the Guard can prepare and review a formal report. It implies no new numeric threshold and no Guard-specific course. The etiquette-ready fact supports formal encounters while keeping social status separate from evidence. Guard defines no numeric threshold for it. Officer is built around formal responsibility: a sound report, authorized access, and the ability to organize a decision so it can be reviewed later. It is neither an automatic ending nor a title without evidence.",
          "conditions": [],
          "media": []
        }
      ],
