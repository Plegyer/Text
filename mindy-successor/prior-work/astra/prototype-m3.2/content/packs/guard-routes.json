              "present": true
            }
          ],
          "effects": [
            {
              "kind": "addCareerFact",
              "career": "guard",
              "fact": "crisis-resolved"
            },
            {
              "kind": "addCareerFact",
              "career": "guard",
              "fact": "crisis-reform"
            }
          ]
        },
        {
          "id": "trade-access-network",
          "label": "Resolve it through controlled access and contacts",
          "text": "The controlled-access route uses a verified pass, a documented discrepancy, and professional contacts. Connections explain who can carry the review forward; they are not a corruption currency.",
          "conditions": [
            {
              "kind": "careerFact",
              "career": "guard",
              "fact": "cargo-pass-evidence",
              "present": true
            },
            {
              "kind": "careerFact",
              "career": "guard",
              "fact": "sealed-pass-issued",
              "present": true
            },
            {
              "kind": "careerFact",
              "career": "guard",
              "fact": "relationship-conflict-resolved",
              "present": true
            }
          ],
          "effects": [
            {
              "kind": "addCareerFact",
              "career": "guard",
              "fact": "crisis-resolved"
            },
            {
              "kind": "addCareerFact",
              "career": "guard",
              "fact": "crisis-network"
            }
          ]
        },
        {
          "id": "defer",
          "label": "Keep the situation contained for now",
          "text": "If no supported route is ready, the crisis can be contained without claiming it has been solved. Deferral is better than manufactured certainty.",
          "conditions": [],
          "effects": []
