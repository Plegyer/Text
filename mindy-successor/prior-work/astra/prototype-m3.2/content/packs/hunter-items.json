  "events": [
    {
      "id": "hunter.items.preserve-return",
      "title": "Preserve what the expedition actually found",
      "sourceDomain": "hunter",
      "trigger": [],
      "reactionTriggers": [
        {
          "kind": "activityResult",
          "activity": "hunter.expedition",
          "outcome": "success",
          "result": "hunter.expedition.success"
        }
      ],
      "priorityClass": "critical_progression",
      "priority": 86,
      "blocking": true,
      "delivery": {
        "policy": "live"
      },
      "cooldownDays": 0,
      "variantCooldownDays": 0,
      "maxShows": 1,
      "conditions": [
        {
          "kind": "itemCapability",
          "capability": "preserve_specimen",
          "present": true
        },
        {
          "kind": "careerFact",
          "career": "hunter",
          "fact": "expedition-returned",
          "present": true
        },
        {
          "kind": "careerFact",
          "career": "hunter",
          "fact": "expedition-preserved-sample",
          "present": false
        }
      ],
      "variants": [
        {
          "id": "rare-investigation",
          "text": "On a rare-contract return, the Field Preservation Kit lets you separate observation from story: preserve the physical evidence, label where it came from, and leave its final identity unresolved.",
          "conditions": [
            {
              "kind": "careerFact",
              "career": "hunter",
              "fact": "rare-contract-active",
              "present": true
            }
          ],
          "media": []
        },
        {
          "id": "default",
          "text": "After a successful expedition, the Field Preservation Kit lets you keep evidence in a form that can be compared later. Preservation is an extraction choice, not a trophy requirement and not a new combat system.",
          "conditions": [],
          "media": []
        }
      ],
      "choices": [
        {
          "id": "preserve",
          "label": "Preserve the field evidence",
          "text": "Use the existing preserve_specimen capability and record the Hunter sample fact for later comparison.",
          "conditions": [],
          "effects": [
            {
              "kind": "addCareerFact",
              "career": "hunter",
              "fact": "expedition-preserved-sample"
            }
          ]
        },
        {
          "id": "leave",
          "label": "Leave the evidence unpreserved",
          "text": "Keep the successful return without taking or formalizing this evidence; the career remains playable.",
          "conditions": [],
          "effects": []
        }
      ]
    },
    {
      "id": "hunter.items.rough-route-return",
      "title": "Turn Rope Kit use into route knowledge",
      "sourceDomain": "hunter",
      "trigger": [],
      "reactionTriggers": [
        {
          "kind": "activityResult",
          "activity": "hunter.expedition",
          "outcome": "success",
          "result": "hunter.expedition.success"
        },
        {
          "kind": "careerFactAdded",
          "career": "hunter",
          "fact": "expedition-preserved-sample"
        }
      ],
      "priorityClass": "normal_progression",
      "priority": 82,
      "blocking": true,
      "delivery": {
        "policy": "live"
      },
      "cooldownDays": 0,
      "variantCooldownDays": 0,
      "maxShows": 1,
      "conditions": [
        {
          "kind": "itemCapability",
          "capability": "cross_rough_route",
          "present": true
        },
        {
          "kind": "careerFact",
          "career": "hunter",
          "fact": "expedition-returned",
          "present": true
        },
        {
          "kind": "careerFact",
          "career": "hunter",
          "fact": "expedition-rough-route",
          "present": false
        }
      ],
      "variants": [
        {
          "id": "default",
          "text": "The Rope Kit changed which rough ground was practical to cross, not how much damage you could deal. A successful return lets you record where the secured crossing worked and what preparation the route needs next time.",
          "conditions": [],
          "media": []
        }
      ],
      "choices": [
        {
          "id": "record",
          "label": "Record the rope-assisted route",
          "text": "Keep the existing cross_rough_route capability as typed Hunter route knowledge.",
          "conditions": [],
          "effects": [
            {
              "kind": "addCareerFact",
              "career": "hunter",
              "fact": "expedition-rough-route"
            }
          ]
        },
        {
          "id": "skip",
          "label": "Keep it as field experience only",
          "text": "Keep the Rope Kit and normal expedition access without formalizing a progression fact.",
          "conditions": [],
          "effects": []
        }
      ]
    }
