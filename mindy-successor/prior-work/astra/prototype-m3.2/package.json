{
  "name": "portal-life",
  "version": "0.1.0",
  "private": true,
  "description": "Фэнтезийная life-sim RPG — первый проверяемый срез",
  "author": "Portal Life project",
  "license": "UNLICENSED",
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "node --experimental-strip-types scripts/validate.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm run validate && npm run build && npm test",
    "start": "npm run build && electron .",
    "preview": "node scripts/serve.mjs",
    "dist:win": "npm run check && electron-builder --win nsis --x64",
    "checkpoint": "node scripts/checkpoint.mjs",
    "check:package": "node --experimental-strip-types scripts/check-package.ts"
  },
  "build": {
    "appId": "game.portal-life.desktop",
    "productName": "Portal Life",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "zod": "4.1.12"
  }
}
